# =====================================================================
# Demo routing shape without ACME TLS (plain HTTP, loopback only).
#
#   http://127.0.0.1:8080/            -> rendered lead form (var/www)
#   http://127.0.0.1:8080/webhook/*   -> local n8n
#
# Used only for the locally hosted, authenticated demo. A tunnel forwards
# public HTTPS to this loopback listener; Basic Authentication remains
# enabled at this origin.
#
#   * local rehearsal / tests (Caddyfile.local as-is)
#   * Milestone 13 public edge: a tunnel forwards its public HTTPS
#     listener to 127.0.0.1:8080, so TLS terminates at the platform
#     edge and the loopback hop carries the request to Caddy. The
#     site block binds loopback-only so nothing is reachable on LAN
#     interfaces besides the intended edge.
#
#   LEAD_WWW_ROOT=$PWD/var/www \
#     caddy run --config deploy/caddy/Caddyfile.local
# =====================================================================
{
	auto_https off
}

:8080 {
	# Loopback-only listener: the site address host would become a Host
	# matcher (breaking localhost vs 127.0.0.1), so restrict the actual
	# bind here. Only local processes (tests, edge tunnel) can connect.
	bind 127.0.0.1

	encode gzip

	basic_auth argon2id {
		{$DEMO_AUTH_USER} {$DEMO_AUTH_HASH}
	}

	handle /webhook/* {
		reverse_proxy 127.0.0.1:5678 {
			header_up -Authorization
		}
	}

	handle {
		root * {$LEAD_WWW_ROOT}
		file_server
	}
}
