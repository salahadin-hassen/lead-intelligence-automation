# =====================================================================
# FastAPI lead API — application configuration (production template)
# =====================================================================
# Copy to deploy/env/api.env (gitignored) and fill in real values.
# The filled-in file must NEVER be committed (see .gitignore).
#
# Loaded by:
#   - systemd:   deploy/systemd/lead-api.service (EnvironmentFile=)
#   - no-root:   deploy/bin/stack.sh start
#
# This file is APPLICATION configuration only. n8n gets its own
# deploy/env/n8n.env; the browser form gets deploy/env/form.env.
# =====================================================================

# --- PostgreSQL (required) ------------------------------------------
# Persistent production database. The sql/*.sql migrations are applied
# automatically at every API startup (idempotent — this is the one and
# only migration system). Deploy/bin/migrate.sh applies them explicitly.
DATABASE_URL=postgresql://lead_app:CHANGE_ME@127.0.0.1:5432/lead_automation

# --- LLM lead scoring (optional) ------------------------------------
# OpenRouter free-model routing is the default. Leave the key empty to use
# the deterministic local heuristic with no external inference service.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_API_KEY=

# --- HTTP listener ---------------------------------------------------
# Bind to loopback: the API must NOT be reachable from the internet.
# Only the reverse proxy path (n8n -> API) and local ops use it.
API_HOST=127.0.0.1
API_PORT=8000

# NOTE: TEST_DATABASE_URL is a development/test concern only (tests write
# to a separate database). Do not set it in production.
