# =====================================================================
# Lead form document root — configuration (production template)
# =====================================================================
# Copy to deploy/env/form.env (gitignored) and fill in real values.
#
# Loaded by deploy/bin/render-form.sh (called by stack.sh, or run alone):
# it writes var/www/{index.html,lead-form.html,config.js} — config.js is
# GENERATED from the variable below, which is the single place the
# webhook URL is configured for deployments. The committed
# demo/config.js is only the local development default.
# =====================================================================

# What the BROWSER submits to.
# Same-origin deployment (recommended — form and webhook share the Caddy
# domain, so no CORS applies at all): a path is enough.
DEMO_N8N_WEBHOOK_URL=/webhook/lead-intake
# Cross-origin alternative (form hosted somewhere else than the webhook):
# DEMO_N8N_WEBHOOK_URL=https://CHANGE_ME.example/webhook/lead-intake
