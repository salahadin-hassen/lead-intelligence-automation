# =====================================================================
# n8n workflow engine — configuration (production template)
# =====================================================================
# Copy to deploy/env/n8n.env (gitignored) and fill in real values.
# The filled-in file must NEVER be committed.
#
# Loaded by:
#   - systemd: deploy/systemd/lead-n8n.service (EnvironmentFile=)
#   - no-root: deploy/bin/stack.sh start
#
# The Telegram bot token does NOT belong here: it lives only in n8n's
# own credential store (encrypted, N8N_ENCRYPTION_KEY below). This file
# carries the non-secret n8n/workflow configuration.
# =====================================================================

# --- Listener (loopback only) ---------------------------------------
# N8N_LISTEN_ADDRESS is the actual bind address (verified against the
# installed n8n 2.41.7 source). Bind to loopback so ONLY the reverse
# proxy can reach n8n; never expose the editor or API routes publicly.
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678

# --- Public URLs (no localhost assumptions) --------------------------
# N8N_WEBHOOK_URL = the public ORIGIN with a trailing slash. Verified
# against n8n 2.41.7: n8n appends "webhook/<path>" itself, so do NOT
# include /webhook/ in this value.
#   e.g. N8N_WEBHOOK_URL=https://lead.example.com/
N8N_WEBHOOK_URL=https://CHANGE_ME.example/
N8N_PROTOCOL=https
# Editor/admin UI stays loopback (tunnel for access: ssh -L 5678:127.0.0.1:5678 <host>).
N8N_EDITOR_BASE_URL=http://127.0.0.1:5678

# --- Persistent data (explicit; must survive restarts/redeploys) -----
# Actual data directory becomes $N8N_USER_FOLDER/.n8n (workflow DB,
# credentials, execution history). Back this directory up.
N8N_USER_FOLDER=/var/lib/lead-intake
# Pin the credential encryption key so encrypted credentials survive
# reinstalls and restores. Generate ONCE (openssl rand -hex 32), store
# it off-repo with the other secrets. Changing it orphans credentials.
N8N_ENCRYPTION_KEY=CHANGE_ME

# --- Workflow configuration (workflow JSON reads these at runtime) ---
# REQUIRED in production: the committed workflow's default is a
# localhost development URL (deliberate override point).
LEAD_API_BASE_URL=http://127.0.0.1:8000
# Optional override; the workflow default is 70.
LEAD_QUALIFIED_THRESHOLD=70
# The workflow's Code nodes read $env.TELEGRAM_CHAT_ID etc.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
TELEGRAM_CHAT_ID=CHANGE_ME

# --- Optional hygiene ------------------------------------------------
N8N_DIAGNOSTICS_ENABLED=false
# Port gotcha (documented in docs/n8n-integration.md): the n8n task-runner
# broker defaults to 5679. Override it only if that port is already taken:
# N8N_RUNNERS_BROKER_PORT=5681
