DATABASE_URL=postgresql://lead_app:<password>@localhost:5432/lead_automation
TEST_DATABASE_URL=postgresql://lead_app:<password>@localhost:5432/lead_automation_test

# Optional LLM scoring. OpenRouter's free-model router is the default;
# an empty key uses the local deterministic heuristic scorer.
# Never commit real credentials; never print these values.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_API_KEY=

# Optional AI lead insights (docs/ai-lead-insights.md). Off by default.
# Use OPENAI_API_KEY, NOT LLM_API_KEY: LLM_API_KEY replaces the deterministic score.
AI_INSIGHTS_ENABLED=false
OPENAI_API_KEY=
AI_INSIGHTS_MODEL=gpt-6-luna
AI_INSIGHTS_REASONING_EFFORT=none
AI_INSIGHTS_TIMEOUT_SECONDS=15
AI_INSIGHTS_MAX_OUTPUT_TOKENS=300
AI_INSIGHTS_MAX_INPUT_CHARS=2000
